{
  "kind": "analysis-suite",
  "name": "Double Gyre",
  "description": "Analytical time-periodic double-gyre field with the full ModalPy run matrix.",
  "case": {
    "name": "double_gyre",
    "case_type": "analytical",
    "description": "Time-periodic double-gyre example.",
    "data": {
      "kind": "generator",
      "name": "double_gyre",
      "params": {
        "Nx": 80,
        "Ny": 40,
        "Nt": 200
      }
    },
    "spatial_weight_type": "uniform",
    "n_modes_save": 10,
    "nfft": 64,
    "overlap": 0.5,
    "embedding_dim": 20,
    "generate_plots": true
  },
  "runs": [
    { "id": "pod", "method": "pod" },
    { "id": "mpod", "method": "mpod", "params": { "band_edges": [0.0, 0.15, 0.35, 1.0], "band_scale": "normalized_nyquist" } },
    { "id": "dmd_ls", "method": "dmd", "params": { "method": "ls", "delays": 1 } },
    { "id": "dmd_tls", "method": "dmd", "params": { "method": "tls", "delays": 1 } },
    { "id": "hodmd", "method": "hodmd", "params": { "delays": 4 } },
    { "id": "tls_hodmd", "method": "tls-hodmd", "params": { "delays": 4 } },
    { "id": "spod", "method": "spod" },
    { "id": "psd_pod", "method": "psd-pod" },
    { "id": "bsmd", "method": "bsmd" },
    { "id": "stpod", "method": "stpod" }
  ]
}
